NODE_ENV=development
PORT=4500
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=postgresql://vibesafe:change-me@localhost:5432/vibesafe?schema=public
AUTH_BYPASS=true

# Added when Salesforce OAuth is enabled
SALESFORCE_CLIENT_ID=
# Optional for External Client Apps configured as public PKCE clients.
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:4500/api/v1/org-connections/oauth/callback
SALESFORCE_API_VERSION=61.0
# Set this after creating the 2GP beta/released version (starts with 04t).
SALESFORCE_CONNECTOR_PACKAGE_VERSION_ID=
TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
AI_REQUEST_TIMEOUT_MS=90000
SALESFORCE_CODE_ANALYZER_ENABLED=true
SALESFORCE_CODE_ANALYZER_COMMAND=sf.cmd
SALESFORCE_CODE_ANALYZER_TIMEOUT_MS=180000
SCAN_COMPONENT_BATCH_SIZE=100
AI_COMPONENT_CONCURRENCY=3
